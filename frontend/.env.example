# Supabase Configuration (REQUIRED for multi-device sync on Netlify)
# Create a Supabase project at https://supabase.com and get these values
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Provider Configuration
# Options: openrouter (default) | gemini
VITE_AI_PROVIDER=openrouter

# OpenRouter (primary provider — works with any OpenAI-compatible model)
# Get your API key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
# Model to use (see https://openrouter.ai/models for options)
# Popular choices: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
VITE_OPENROUTER_MODEL=openai/gpt-4o

# Legacy Gemini AI key (only used if VITE_AI_PROVIDER=gemini)
VITE_GEMINI_API_KEY=

# === DEPLOYMENT INSTRUCTIONS ===
# For Netlify deployment:
# 1. Create a Supabase project at https://supabase.com
# 2. Run supabase-migration.sql in the Supabase SQL Editor
# 3. Set these environment variables in Netlify dashboard:
#    - VITE_SUPABASE_URL
#    - VITE_SUPABASE_ANON_KEY
#    - VITE_AI_PROVIDER
#    - VITE_OPENROUTER_API_KEY
#    - VITE_OPENROUTER_MODEL
# 4. Deploy the frontend/ directory to Netlify
# 5. Users can now access the same data from any device!
